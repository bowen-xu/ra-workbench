{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Assistant",
  "version": "0.8.0",
  "identifier": "com.bowenxu.research-assistant",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node ../../scripts/prepare-web-build.mjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Research Assistant",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 21
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      ".generated/codex/codex": "codex/codex",
      ".generated/docling/": "docling/",
      "../docling-daemon/licenses/": "licenses/docling/",
      "THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../packages/agent-core/third-party/codex/LICENSE": "licenses/CODEX_LICENSE",
      "../../../packages/agent-core/third-party/codex/NOTICE": "licenses/CODEX_NOTICE"
    },
    "category": "Education",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A local-first research workspace for literature, evidence, notes and traceable synthesis.",
    "shortDescription": "Local-first research workspace",
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "files": {
        "Frameworks/libresearch_semantic_engine.dylib": ".generated/semantic-engine/libresearch_semantic_engine.dylib"
      },
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.research-assistant.invalid/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNDk1MzFCNDg5NkMwMDAKUldRQXdKWklHMU5KazVoWGNIV3B6VDdDazVLWFdTSFpCOW9tLytxeVNEakVwNkl0VmJmL0tXRksK"
    }
  }
}
