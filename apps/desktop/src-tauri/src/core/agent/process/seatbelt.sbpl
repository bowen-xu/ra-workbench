; Adapted from OpenAI Codex sandboxing/src/seatbelt_base_policy.sbpl and
; restricted_read_only_platform_defaults.sbpl at
; e363b08c9175ac1cbe5893615dd2cb9ddf95043b. Copyright 2025 OpenAI. Apache-2.0.
; See packages/agent-core/third-party/codex/{LICENSE,NOTICE}.
; Local profile omits network, shared temp, preferences, app extensions and IPC.
(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
; Runtime container initialization and guarded system vnodes (Codex defaults).
(allow system-mac-syscall (mac-policy-name "vnguard"))
(allow system-mac-syscall
  (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))
(allow file-read* file-map-executable
  (subpath "/bin") (subpath "/sbin")
  (subpath "/usr/bin") (subpath "/usr/sbin")
  (subpath "/usr/lib") (subpath "/usr/libexec")
  (subpath "/System/Library"))
(allow file-read* (literal "/"))
(allow file-read* (literal "/private/var/select/sh")
  (literal "/private/etc/ssl/openssl.cnf"))
(allow file-read-metadata (literal "/") (literal "/dev")
  (literal "/System/Volumes") (literal "/System/Volumes/Data"))
(allow file-read* (literal "/dev/random") (literal "/dev/urandom")
  (literal "/dev/zero"))
(allow file-read* file-write-data (literal "/dev/null"))
; The host opens a PTY before entering Seatbelt. Permit terminal configuration
; on its inherited stdio without granting open/read/write access to other TTYs.
(allow file-ioctl (regex #"^/dev/ttys[0-9]+$"))
(allow sysctl-read
  (sysctl-name "hw.ncpu") (sysctl-name "hw.activecpu")
  (sysctl-name "hw.pagesize") (sysctl-name "hw.memsize")
  (sysctl-name "kern.osrelease") (sysctl-name "kern.ostype")
  (sysctl-name "kern.osversion") (sysctl-name "kern.argmax")
  (sysctl-name "security.mac.lockdown_mode_state") (sysctl-name "kern.bootargs"))
(allow file-read* file-write* file-map-executable (subpath (param "WORK")))
; Parent/control directories remain outside the write scope. Prevent replacing
; the root itself even if a platform rule is later expanded.
(deny file-write-unlink (literal (param "WORK")))
