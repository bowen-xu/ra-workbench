# Adapted from github/gitignore Node.gitignore and Global/macOS.gitignore (CC0).
# https://github.com/github/gitignore/blob/main/Node.gitignore
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore
# React / TypeScript / Vite template reference
# https://github.com/vitejs/vite/blob/main/packages/create-vite/template-react-ts/_gitignore

# OS and editor-local files
.DS_Store
._*
Thumbs.db
.idea/
*.swp
*.swo

# Local environment and signing configuration
.env
.env.*
!.env.example
.release/

# Node dependencies, including local integration symlinks
node_modules
.pnpm-store
.npm/

# JavaScript / TypeScript build output and tool caches
dist/
dist-ssr/
build/
out/
.vite/
.vite-temp/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
vite.config.*.timestamp-*
/*.tgz

# Logs and Node diagnostic reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.json

# Coverage and browser-test output
coverage/
.nyc_output/
*.lcov
/test-results/
/playwright-report/
/blob-report/
playwright/.cache/
output/playwright/
.playwright-cli/

# Temporary files and local databases
.tmp/
tmp/
temp/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal

# Cargo.lock, pnpm-lock.yaml, manifests and source files remain versioned.

# Rust template reference (CC0)
# https://github.com/github/gitignore/blob/main/Rust.gitignore
target/
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Tauri 2 scaffold template, adapted to this desktop source directory
# https://github.com/tauri-apps/create-tauri-app/blob/c6f5cf68942f187ba7bb738a49ee505c28e6ca5a/templates/_base_/src-tauri/_gitignore
/apps/desktop/src-tauri/gen/schemas/
/apps/desktop/src-tauri/.generated/
/apps/web/src/.generated/
/apps/web/public/dictionary/

# C++ / CMake intermediates used by the native document parser (CC0 references)
# https://github.com/github/gitignore/blob/main/C%2B%2B.gitignore
# https://github.com/github/gitignore/blob/main/CMake.gitignore
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.ilk
*.dwo
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.exe
*.app/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json

# Versioned public dependency artifacts
/.dependencies/
